# Leave everything empty to run the full app on the built-in demo market (no keys, no money).

# --- Claude agents (Analyst, Devil's advocate, Manager, Reviewer, Coach) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AGENT_EFFORT=medium            # low | medium | high — main lever on agent cost
MAX_CANDIDATES_PER_CYCLE=3     # how many LAYA-approved stocks reach Claude each scan
AGENT_TEAM=starter             # starter: news/chart/company/mood specialists are rule-based (cheaper)
                               # full: each specialist is its own Claude agent (~2x agent cost)

# --- Alpaca: broker + market data (paper trading by default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex           # sip needs a paid Alpaca data plan
WATCHLIST=                     # e.g. AAPL,MSFT,NVDA — empty = built-in list

# --- Optional extra data ---
FINNHUB_API_KEY=               # second price source, earnings dates & surprises, analyst ratings, economic calendar
FMP_API_KEY=                   # fundamentals for company checks + halal ratios, economic calendar fallback
FRED_API_KEY=                  # free at fred.stlouisfed.org: VIX, Fed funds rate, 10-year yield, oil
SEC_USER_AGENT="Rahbeh research you@example.com"   # SEC EDGAR filings (free) — put your real contact email

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
DATABASE_URL=sqlite:///./rahbeh.db   # or postgresql+psycopg://user:pass@host/rahbeh
SCAN_INTERVAL_SECONDS=60
DEMO_ALWAYS_OPEN=true          # demo market trades 24/7; live mode follows real market hours
