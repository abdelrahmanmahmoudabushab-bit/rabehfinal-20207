# Leave everything empty to run the full app on the built-in demo market (no keys, no money).

# --- Claude agents (Analyst, Devil's advocate, Manager, Position keeper, Reviewer, Coach) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AGENT_EFFORT=medium            # low | medium | high — main lever on agent cost
MAX_CANDIDATES_PER_CYCLE=3     # how many LAYA-approved stocks reach Claude each scan
AGENT_TEAM=starter             # starter: news/chart/company/mood specialists are rule-based (cheaper)
                               # full: each specialist is its own Claude agent (more calls, but on SPECIALIST_MODEL)
HUNT_DEPTH=5                   # deal finder: shortlist size (top-ranked stocks that get the full review); at most 3 finalists reach the devil's advocate
KEEPER_INTERVAL_SECONDS=300    # how often the Claude Position keeper re-checks each open trade (rules run every cycle)

# --- Alpaca: broker + market data (paper trading by default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex           # sip needs a paid Alpaca data plan
WATCHLIST=                     # e.g. AAPL,MSFT,NVDA — empty = built-in list

# --- Optional extra data ---
FINNHUB_API_KEY=               # second price source (the two-source check only runs when set), earnings dates & surprises, analyst ratings, economic calendar
                               # live mode: without it the earnings date is unknown and trades are blocked ("earnings date unknown"); demo mode is unaffected
FMP_API_KEY=                   # fundamentals for company checks + halal ratios, economic calendar fallback
                               # live mode without it: halal debt/cash ratios use built-in illustrative figures, not live filings
FRED_API_KEY=                  # free at fred.stlouisfed.org: VIX, Fed funds rate, 10-year yield, oil
SEC_USER_AGENT="Rahbeh research you@example.com"   # SEC EDGAR filings (free) — put your real contact email

# --- Alerts ---
# Alerts need BOTH the bot token and the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
DATABASE_URL=sqlite:///./rahbeh.db   # or postgresql+psycopg://user:pass@host/rahbeh
SCAN_INTERVAL_SECONDS=60
DEMO_ALWAYS_OPEN=true          # demo market trades 24/7; live mode follows real market hours

# --- Backtester: every trade is tested 1,000+ ways before it can be proposed ---
BACKTEST_GATE=true             # block trades whose setup shows no out-of-sample edge
BACKTEST_ADOPT_EXITS=true      # use the tested stop/target/holding time instead of the Manager's guess
BACKTEST_DAYS=60               # trading days of 5-minute history per stock
BACKTEST_BASKET=8              # the stock + peers (same sector first)
BACKTEST_SLIP_BPS=3            # slippage charged per side
BACKTEST_MIN_OOS_TRADES=15
BACKTEST_MIN_OOS_EXP_R=0.05
BACKTEST_MIN_OOS_T=0.5         # out-of-sample t-stat bar; it rises by BACKTEST_DEFLATE x ln(variants the winner was picked from)
BACKTEST_DEFLATE=0.1
BACKTEST_WORKERS=1             # backtests run in a separate process (0 = in the API process)
BACKTEST_PRECOMPUTE=true       # 17:00 ET on weekdays: test every stock x setup x filter pattern for tomorrow
SPECIALIST_MODEL=claude-haiku-5-5  # News/Chart/Company/Mood readers (only used with AGENT_TEAM=full); empty = main model
ALPACA_STREAM=true             # websocket prices in live mode; polling stays as the fallback
STREAM_MOVE_PCT=1.0            # a stock moving this much in a minute wakes the scanner immediately

# --- Cost and execution controls ---
AGENT_COOLDOWN_MINUTES=30      # rejected stocks aren't re-analyzed (and re-billed) for this long unless news lands
DAILY_AI_BUDGET_USD=25         # past this, agents use free rules until tomorrow (0 = no cap)
MAX_ENTRY_SLIP_BPS=10          # the entry limit order sits this far above the live price at the moment of the order
MAX_PLAN_DRIFT_PCT=0.4         # an idea expires when the live price is already this % above its planned entry

# --- Security ---
CORS_ORIGINS=http://localhost:3000   # browser origins the API accepts
API_TOKEN=                     # long random string; the web app sends it to the API (required with docker compose)
# The web app reads RAHBEH_PASSWORD (+ optional RAHBEH_USER) to put a login in front of everything.
